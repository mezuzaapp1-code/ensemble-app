# --- API keys ---
GEMINI_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- JWT (required in production on Railway / any public host) ---
JWT_SECRET=your-strong-secret-here

# --- Founder dashboard / budget ---
FOUNDER_API_BUDGET_USD=50

# --- SQLite ---
# Relative path resolves next to main.py inside the container; use a Railway volume mount
# path if you need persistence across redeploys.
DATABASE_URL=sqlite:///conversations.db

# --- Optional ---
# Railway sets PORT automatically; locally you can use ENSEMBLE_PORT instead.
ENSEMBLE_PORT=8080
# Local dev hot-reload only (never enable in Dockerfile / Railway start command):
ENSEMBLE_RELOAD=1
ENSEMBLE_DEV_MODE=1
