# --- API keys ---
GEMINI_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- JWT (required in production on Railway / any public host) ---
# Changing JWT_SECRET invalidates existing tokens until users sign in again (401 on /ensemble/stream).
JWT_SECRET=your-strong-secret-here
# Default: 1 day without "Remember me"; 7 days when remember_me is true (see JWT_REMEMBER_ME_DAYS).
JWT_SESSION_DAYS=1
JWT_REMEMBER_ME_DAYS=7
# Optional: log JWT decode failures to server logs (never prints the secret).
# ENSEMBLE_DEBUG_AUTH=1

# --- Founder dashboard / budget ---
FOUNDER_API_BUDGET_USD=50

# Free tier: max ensemble messages per rolling 24h (authenticated users; Pro tier skips).
FREE_USER_LIMIT=5

# --- Database ---
# Omit DATABASE_URL to use bundled SQLite (file next to main.py).
# SQLite explicit:
DATABASE_URL=sqlite:///conversations.db
# PostgreSQL (e.g. Railway: paste the DATABASE_URL variable from the Postgres plugin).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# --- Optional ---
# Founder /status · Railway cloud cost (GraphQL backboard.railway.com — create token at https://railway.com/account/tokens )
# RAILWAY_TOKEN=
# Or alias:
# RAILWAY_API_KEY=
# RAILWAY_WORKSPACE_ID=        # required if token sees multiple workspaces; Cmd/Ctrl+K in dashboard copies id
# RAILWAY_PROJECT_ID=           # optional — scope estimatedUsage to one project
# RAILWAY_GRAPHQL_URL=https://backboard.railway.com/graphql/v2
# RAILWAY_CREDITS_REMAINING_HINT_USD=   # paste “credits left” from Railway UI if API has no balance
# RAILWAY_INCLUDED_USAGE_USD_PER_CYCLE=  # e.g. trial monthly $5 — rough remainder vs projected cycle
# RAILWAY_WORKSPACE_NAME_MATCH=   # pick workspace by exact name when multiple exist
# Competitor / market search (product-idea flow)
# TAVILY_API_KEY=
# Low-consensus analyzer defaults to gpt-fast; override only if needed:
# ENSEMBLE_ANALYZER_MODEL=gpt-fast
# Listen port: Dockerfile uses PORT (Railway injects this) defaulting to 8080 locally.
# For `python main.py`, PORT or ENSEMBLE_PORT applies.
ENSEMBLE_PORT=8080
# Local dev hot-reload only (never enable in Dockerfile / Railway start command):
ENSEMBLE_RELOAD=1
ENSEMBLE_DEV_MODE=1
