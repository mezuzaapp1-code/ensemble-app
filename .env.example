# --- API keys ---
GEMINI_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- JWT (required in production on Railway / any public host) ---
JWT_SECRET=your-strong-secret-here

# --- Founder dashboard / budget ---
FOUNDER_API_BUDGET_USD=50

# --- Database ---
# Omit DATABASE_URL to use bundled SQLite (file next to main.py).
# SQLite explicit:
DATABASE_URL=sqlite:///conversations.db
# PostgreSQL (e.g. Railway: paste the DATABASE_URL variable from the Postgres plugin).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# --- Optional ---
# Competitor / market search (product-idea flow)
# TAVILY_API_KEY=
# Low-consensus analyzer defaults to gpt-fast; override only if needed:
# ENSEMBLE_ANALYZER_MODEL=gpt-fast
# Listen port: Dockerfile uses PORT (Railway injects this) defaulting to 8080 locally.
# For `python main.py`, PORT or ENSEMBLE_PORT applies.
ENSEMBLE_PORT=8080
# Local dev hot-reload only (never enable in Dockerfile / Railway start command):
ENSEMBLE_RELOAD=1
ENSEMBLE_DEV_MODE=1
